# Data source: "mock" runs offline with seed data and needs no secrets.
# Any other value requires the Supabase vars below.
NEXT_PUBLIC_DATA_MODE=

# "mock" is refused in production builds unless NEXT_PUBLIC_E2E=1 (E2E harness only).
NEXT_PUBLIC_E2E=
# Server-only opt-in for the E2E store route /api/mock-store (also needs NEXT_PUBLIC_E2E=1 and no Supabase URL).
E2E_ALLOW_MOCK_STORE=

# Supabase (required unless NEXT_PUBLIC_DATA_MODE=mock): Project settings -> API.
# Sign-in is email + password: no OTP template is needed. Authentication -> Providers -> Email must have
# "Confirm email" = OFF, otherwise sign-up returns no session.
# The anon key is public by design; every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (optional: without all three, captures still work but no notification is sent).
# Generate with: npx web-push generate-vapid-keys. The public key is inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Reminders (slice 5). Min 16 chars, e.g. `openssl rand -hex 32`. Vercel Cron sends it as `Authorization: Bearer ...` to
# /api/cron/daily, and the server passes it to the secret-gated RPCs (remind, run_daily_reminders). The database stores only
# its sha256 (private.server_secrets, see README "Напоминания: CRON_SECRET"). Without it both routes stay closed.
CRON_SECRET=

# Telegram DM bot (slice 12). Values live in Vercel only. The webhook secret needs 16+ chars (`openssl rand -hex 24`).
# After deploy, once: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<domain>/api/telegram/setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @ (public, used for the t.me deep link). Defaults to obshagk_bot.
NEXT_PUBLIC_TELEGRAM_BOT=
